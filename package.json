{
  "name": "ai-news-digest",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "Daily AI news digest aggregated from RSS feeds",
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build",
    "collect": "tsx scripts/collect.ts",
    "publish-issue": "tsx scripts/publish.ts",
    "rebuild-issue": "tsx scripts/rebuild-issue.ts",
    "preview": "vite preview",
    "check-docs": "tsx scripts/check-doc-links.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.16",
    "@vueuse/core": "^14.3.0",
    "rss-parser": "^3.13.0",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@huberyyang/todo-scripts": "^1.1.1",
    "@iconify-json/lucide": "^1.2.118",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  }
}
